{
  "name": "noskrap",
  "version": "0.3.0",
  "description": "Explainable bot-risk scoring for Next.js applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kacigaya/noskrap.git"
  },
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "default": "./dist/redis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "check": "bun run build && bun test && bun pm pack --dry-run && bun run check:web",
    "check:web": "bun run --cwd web lint && bun run --cwd web build",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0"
  }
}
