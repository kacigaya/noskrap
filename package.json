{
  "name": "noskrap",
  "version": "0.4.0",
  "description": "Explainable bot-risk scoring for Next.js applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kacigaya/noskrap.git"
  },
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "default": "./dist/redis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "check": "bun run build && bun run typecheck:tests && bun test src tests/publish.test.ts && bun run test:redis-sdk && bun run test:integration && bun run test:next15 && bun run test:package && bun run check:web",
    "check:web": "bun run --cwd web lint && bun run --cwd web build",
    "prepack": "bun run build",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test:integration": "bun tests/integration.ts",
    "test:next15": "NOSKRAP_TEST_NEXT_MODULES=tests/next15/node_modules bun tests/integration.ts",
    "test:redis-sdk": "bun tests/redis-sdk.ts",
    "test:package": "bun tests/package.ts"
  },
  "peerDependencies": {
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@upstash/redis": "1.39.0",
    "ioredis": "6.0.0",
    "redis": "6.3.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
